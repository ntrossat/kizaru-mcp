# Your Lightdash instance.
LIGHTDASH_URL=http://localhost:8080

# The address MCP clients reach this server at. For Claude.ai, a public HTTPS address, such as a tunnel's.
PUBLIC_URL=http://localhost:8000

# Required. The OAuth client this server signs users in with: register it as in docs/configuration.md.
LIGHTDASH_CLIENT_ID=
LIGHTDASH_CLIENT_SECRET=

# Required. Encrypts what is stored in Redis. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Where sign-ins and tokens are kept.
REDIS_URL=redis://localhost:6379/0

# Where the server listens.
HOST=127.0.0.1
PORT=8000
