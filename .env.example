# Lightdash instance (local demo: examples/full-jaffle-shop-demo)
LIGHTDASH_URL=http://localhost:8080

# OAuth client from POST /api/v1/oauth/register
LIGHTDASH_CLIENT_ID=
LIGHTDASH_CLIENT_SECRET=

# Public base URL of this server: issuer and resource URL (tunnel URL for Claude.ai)
PUBLIC_URL=http://localhost:8000

# Encrypts tokens at rest. Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

REDIS_URL=redis://localhost:6379/0

HOST=127.0.0.1
PORT=8000
